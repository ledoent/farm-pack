<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="farm_qbo_connection_view_list" model="ir.ui.view">
        <field name="name">farm.qbo.connection.list</field>
        <field name="model">farm.qbo.connection</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" />
                <field name="environment" />
                <field name="realm_id" />
                <field
                    name="state"
                    widget="badge"
                    decoration-success="state == 'connected'"
                    decoration-info="state == 'disconnected'"
                    decoration-warning="state == 'expired'"
                    decoration-danger="state == 'revoked'"
                />
                <field name="last_synced_at" />
                <field name="import_count" />
            </list>
        </field>
    </record>

    <record id="farm_qbo_connection_view_form" model="ir.ui.view">
        <field name="name">farm.qbo.connection.form</field>
        <field name="model">farm.qbo.connection</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button
                        name="action_open_authorize_url"
                        type="object"
                        string="Connect QuickBooks"
                        invisible="state == 'connected'"
                        class="oe_highlight"
                    />
                    <button
                        name="action_disconnect"
                        type="object"
                        string="Disconnect"
                        invisible="state != 'connected'"
                    />
                    <field name="state" widget="statusbar" />
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="environment" />
                            <field name="realm_id" />
                            <field
                                name="company_id"
                                groups="base.group_multi_company"
                            />
                        </group>
                        <group>
                            <field name="token_expires_at" readonly="1" />
                            <field name="last_synced_at" readonly="1" />
                            <field name="import_count" readonly="1" />
                        </group>
                    </group>
                    <group string="Tokens (MVP — plain text)">
                        <field name="access_token" password="True" />
                        <field name="refresh_token" password="True" />
                    </group>
                </sheet>
                <chatter />
            </form>
        </field>
    </record>

    <record id="farm_qbo_connection_action" model="ir.actions.act_window">
        <field name="name">QuickBooks Connections</field>
        <field name="res_model">farm.qbo.connection</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
