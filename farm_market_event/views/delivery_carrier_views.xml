<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="delivery_carrier_view_form_inherit_farm_market" model="ir.ui.view">
        <field name="name">delivery.carrier.form.farm.market</field>
        <field name="model">delivery.carrier</field>
        <field name="inherit_id" ref="delivery.view_delivery_carrier_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="is_farm_market_pickup" />
                <field
                    name="farm_market_next_event_id"
                    readonly="1"
                    invisible="not is_farm_market_pickup"
                />
            </xpath>
        </field>
    </record>
</odoo>
