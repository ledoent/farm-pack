<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="event_event_view_form_inherit_farm_market" model="ir.ui.view">
        <field name="name">event.event.form.farm.market</field>
        <field name="model">event.event</field>
        <field name="inherit_id" ref="event.view_event_form" />
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="before">
                <header>
                    <button
                        name="action_open_preorders"
                        type="object"
                        string="Open Preorders"
                        invisible="not is_farm_market or farm_market_state != 'planning'"
                        class="oe_highlight"
                    />
                    <button
                        name="action_close_preorders"
                        type="object"
                        string="Close Preorders"
                        invisible="not is_farm_market or farm_market_state != 'preorder_open'"
                    />
                    <button
                        name="action_go_live"
                        type="object"
                        string="Go Live"
                        invisible="not is_farm_market or farm_market_state != 'preorder_closed'"
                        class="oe_highlight"
                    />
                    <button
                        name="action_open_picklist_wizard"
                        type="object"
                        string="Pick List — What to Bring"
                        invisible="not is_farm_market or farm_market_state == 'planning'"
                    />
                    <button
                        name="action_close_market"
                        type="object"
                        string="Close Market"
                        invisible="not is_farm_market or farm_market_state == 'closed'"
                    />
                    <field
                        name="farm_market_state"
                        widget="statusbar"
                        invisible="not is_farm_market"
                    />
                </header>
            </xpath>
            <xpath expr="//field[@name='event_type_id']" position="after">
                <field name="is_farm_market" />
                <field name="farm_market_carrier_id" invisible="not is_farm_market" />
                <field name="preorder_cutoff_datetime" invisible="not is_farm_market" />
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page
                    string="Farm Market"
                    name="farm_market"
                    invisible="not is_farm_market"
                >
                    <group>
                        <group>
                            <field name="farm_offering_count" readonly="1" />
                            <field name="farm_preorder_count" readonly="1" />
                        </group>
                        <group>
                            <field name="farm_market_currency_id" invisible="1" />
                            <field
                                name="farm_preorder_revenue"
                                widget="monetary"
                                options="{'currency_field': 'farm_market_currency_id'}"
                                readonly="1"
                            />
                        </group>
                    </group>
                    <separator string="Product Offerings" />
                    <field name="farm_offering_ids">
                        <list editable="bottom">
                            <field name="sequence" widget="handle" />
                            <field name="product_id" />
                            <field name="max_qty" />
                            <field name="list_price" widget="monetary" />
                            <field name="preorder_qty" readonly="1" />
                            <field name="available_qty" readonly="1" />
                            <field name="currency_id" invisible="1" />
                        </list>
                    </field>
                    <separator string="Preorders" />
                    <field name="farm_preorder_ids" readonly="1">
                        <list>
                            <field name="name" />
                            <field name="partner_id" />
                            <field name="amount_total" widget="monetary" />
                            <field name="state" widget="badge" />
                            <field name="currency_id" invisible="1" />
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

    <record id="event_event_view_list_inherit_farm_market" model="ir.ui.view">
        <field name="name">event.event.list.farm.market</field>
        <field name="model">event.event</field>
        <field name="inherit_id" ref="event.view_event_tree" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="is_farm_market" />
                <field
                    name="farm_market_state"
                    widget="badge"
                    optional="show"
                    decoration-info="farm_market_state == 'planning'"
                    decoration-warning="farm_market_state in ('preorder_open', 'preorder_closed')"
                    decoration-success="farm_market_state == 'live'"
                    decoration-muted="farm_market_state == 'closed'"
                />
            </xpath>
        </field>
    </record>

    <record id="farm_market_event_action" model="ir.actions.act_window">
        <field name="name">Farm Markets</field>
        <field name="res_model">event.event</field>
        <field name="view_mode">list,form,calendar</field>
        <field name="domain">[('is_farm_market', '=', True)]</field>
        <field name="context">{'default_is_farm_market': True}</field>
    </record>
</odoo>
