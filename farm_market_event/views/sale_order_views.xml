<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="sale_order_form_inherit_farm_market" model="ir.ui.view">
        <field name="name">sale.order.form.farm.market</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='date_order']" position="after">
                <field name="farm_market_event_id" />
                <field name="farm_market_state" invisible="not farm_market_event_id" />
            </xpath>
        </field>
    </record>

    <record id="sale_order_search_inherit_farm_market" model="ir.ui.view">
        <field name="name">sale.order.search.farm.market</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_sales_order_filter" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="farm_market_event_id" />
            </xpath>
        </field>
    </record>
</odoo>
