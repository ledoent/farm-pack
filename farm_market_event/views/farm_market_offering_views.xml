<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="farm_market_offering_view_list" model="ir.ui.view">
        <field name="name">farm.market.offering.list</field>
        <field name="model">farm.market.offering</field>
        <field name="arch" type="xml">
            <list>
                <field name="event_id" />
                <field name="product_id" />
                <field name="max_qty" />
                <field name="preorder_qty" />
                <field name="available_qty" />
                <field name="list_price" widget="monetary" />
                <field name="currency_id" invisible="1" />
            </list>
        </field>
    </record>
</odoo>
