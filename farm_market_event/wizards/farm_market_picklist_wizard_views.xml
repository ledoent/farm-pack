<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="farm_market_picklist_wizard_view_form" model="ir.ui.view">
        <field name="name">farm.market.picklist.wizard.form</field>
        <field name="model">farm.market.picklist.wizard</field>
        <field name="arch" type="xml">
            <form string="Pick List — What to Bring">
                <group>
                    <field name="event_id" readonly="1" />
                </group>
                <group string="Bring the following">
                    <field name="line_ids" nolabel="1">
                        <list>
                            <field name="product_id" />
                            <field name="preorder_qty" />
                            <field name="max_qty" />
                            <field name="recommended_qty" />
                        </list>
                    </field>
                </group>
                <footer>
                    <button
                        string="Print Pick List"
                        type="object"
                        name="_void_helper"
                        class="oe_highlight"
                        invisible="1"
                    />
                    <button string="Close" class="btn-secondary" special="cancel" />
                </footer>
            </form>
        </field>
    </record>
</odoo>
