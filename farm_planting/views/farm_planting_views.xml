<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="farm_planting_view_list" model="ir.ui.view">
        <field name="name">farm.planting.list</field>
        <field name="model">farm.planting</field>
        <field name="arch" type="xml">
            <list
                decoration-success="state == 'growing'"
                decoration-danger="state == 'failed'"
                decoration-muted="state == 'harvested'"
            >
                <field name="plant_date" />
                <field name="field_id" />
                <field name="crop_id" />
                <field name="qty_seeded" />
                <field name="qty_uom_id" />
                <field name="expected_harvest_date" />
                <field name="state" widget="badge" />
            </list>
        </field>
    </record>

    <record id="farm_planting_view_kanban" model="ir.ui.view">
        <field name="name">farm.planting.kanban</field>
        <field name="model">farm.planting</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state">
                <templates>
                    <t t-name="card">
                        <div class="o_kanban_record_top">
                            <strong>
                                <field name="crop_id" />
                            </strong>
                        </div>
                        <div>
                            <field name="field_id" />
                        </div>
                        <div>
                            <field name="plant_date" />
                        </div>
                        <div class="text-muted">
                            exp. harvest <field name="expected_harvest_date" />
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="farm_planting_view_form" model="ir.ui.view">
        <field name="name">farm.planting.form</field>
        <field name="model">farm.planting</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button
                        name="action_mark_growing"
                        string="Mark Growing"
                        type="object"
                        invisible="state != 'planted'"
                    />
                    <button
                        name="action_mark_harvested"
                        string="Mark Harvested"
                        type="object"
                        invisible="state not in ('planted','growing')"
                        class="oe_highlight"
                    />
                    <button
                        name="action_mark_failed"
                        string="Mark Failed"
                        type="object"
                        invisible="state in ('harvested','failed')"
                    />
                    <field
                        name="state"
                        widget="statusbar"
                        statusbar_visible="planted,growing,harvested"
                    />
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1" />
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="field_id" />
                            <field name="crop_id" />
                            <field name="plant_date" />
                            <field name="expected_harvest_date" />
                        </group>
                        <group>
                            <field name="qty_seeded" />
                            <field name="qty_uom_id" />
                            <field name="season_id" />
                            <field
                                name="company_id"
                                groups="base.group_multi_company"
                            />
                        </group>
                    </group>
                    <notebook>
                        <page string="Notes" name="notes">
                            <field name="notes" />
                        </page>
                    </notebook>
                </sheet>
                <chatter />
            </form>
        </field>
    </record>

    <record id="farm_planting_view_search" model="ir.ui.view">
        <field name="name">farm.planting.search</field>
        <field name="model">farm.planting</field>
        <field name="arch" type="xml">
            <search>
                <field name="field_id" />
                <field name="crop_id" />
                <field name="season_id" />
                <separator />
                <filter
                    string="Planted"
                    name="planted"
                    domain="[('state','=','planted')]"
                />
                <filter
                    string="Growing"
                    name="growing"
                    domain="[('state','=','growing')]"
                />
                <filter
                    string="Harvested"
                    name="harvested"
                    domain="[('state','=','harvested')]"
                />
                <separator />
                <filter
                    string="This Year"
                    name="this_year"
                    domain="[('plant_date','&gt;=', (context_today().replace(month=1,day=1)).strftime('%Y-%m-%d'))]"
                />
                <group name="groupby">
                    <filter
                        string="Field"
                        name="groupby_field"
                        context="{'group_by':'field_id'}"
                    />
                    <filter
                        string="Crop"
                        name="groupby_crop"
                        context="{'group_by':'crop_id'}"
                    />
                    <filter
                        string="State"
                        name="groupby_state"
                        context="{'group_by':'state'}"
                    />
                    <filter
                        string="Season"
                        name="groupby_season"
                        context="{'group_by':'season_id'}"
                    />
                </group>
            </search>
        </field>
    </record>

    <record id="farm_planting_action" model="ir.actions.act_window">
        <field name="name">Plantings</field>
        <field name="res_model">farm.planting</field>
        <field name="view_mode">kanban,list,form</field>
    </record>
</odoo>
