<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!--
        Agricultural UoMs commonly used on US small farms.
        Bushel weights are commodity-specific by USDA convention; these are the
        canonical conversions used for crop reporting. Operators who need a
        different conversion (e.g. test-weight-adjusted bushels) should add a
        company-specific UoM rather than override these.
    -->

    <record id="uom_categ_crop_volume" model="uom.category">
        <field name="name">Crop Volume</field>
    </record>

    <record id="product_uom_bushel_corn" model="uom.uom">
        <field name="name">Bushel (corn, 56 lb)</field>
        <field name="category_id" ref="uom_categ_crop_volume"/>
        <field name="uom_type">bigger</field>
        <field name="factor_inv">1.0</field>
        <field name="rounding">0.01</field>
    </record>

    <record id="product_uom_bushel_soybean" model="uom.uom">
        <field name="name">Bushel (soybean, 60 lb)</field>
        <field name="category_id" ref="uom_categ_crop_volume"/>
        <field name="uom_type">bigger</field>
        <field name="factor_inv">1.071429</field>
        <field name="rounding">0.01</field>
    </record>

    <record id="product_uom_bushel_wheat" model="uom.uom">
        <field name="name">Bushel (wheat, 60 lb)</field>
        <field name="category_id" ref="uom_categ_crop_volume"/>
        <field name="uom_type">bigger</field>
        <field name="factor_inv">1.071429</field>
        <field name="rounding">0.01</field>
    </record>

    <record id="product_uom_hundredweight" model="uom.uom">
        <field name="name">Hundredweight (cwt)</field>
        <field name="category_id" ref="uom.product_uom_categ_kgm"/>
        <field name="uom_type">bigger</field>
        <field name="factor_inv">45.3592</field>
        <field name="rounding">0.01</field>
    </record>

    <record id="product_uom_us_ton" model="uom.uom">
        <field name="name">US Ton (2000 lb)</field>
        <field name="category_id" ref="uom.product_uom_categ_kgm"/>
        <field name="uom_type">bigger</field>
        <field name="factor_inv">907.18474</field>
        <field name="rounding">0.001</field>
    </record>

    <record id="uom_categ_land" model="uom.category">
        <field name="name">Land Area</field>
    </record>

    <record id="product_uom_acre" model="uom.uom">
        <field name="name">Acre</field>
        <field name="category_id" ref="uom_categ_land"/>
        <field name="uom_type">reference</field>
        <field name="factor">1.0</field>
        <field name="rounding">0.001</field>
    </record>

    <record id="product_uom_hectare" model="uom.uom">
        <field name="name">Hectare</field>
        <field name="category_id" ref="uom_categ_land"/>
        <field name="uom_type">bigger</field>
        <field name="factor_inv">2.47105</field>
        <field name="rounding">0.001</field>
    </record>

    <record id="uom_categ_livestock" model="uom.category">
        <field name="name">Livestock Count</field>
    </record>

    <record id="product_uom_head" model="uom.uom">
        <field name="name">Head</field>
        <field name="category_id" ref="uom_categ_livestock"/>
        <field name="uom_type">reference</field>
        <field name="factor">1.0</field>
        <field name="rounding">1.0</field>
    </record>
</odoo>
