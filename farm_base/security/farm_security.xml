<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="module_category_farm" model="ir.module.category">
        <field name="name">Farm</field>
        <field name="description">Farm operations and management</field>
        <field name="sequence">95</field>
    </record>

    <record id="res_groups_privilege_farm" model="res.groups.privilege">
        <field name="name">Farm</field>
        <field name="category_id" ref="module_category_farm" />
        <field name="sequence">10</field>
    </record>

    <record id="group_farm_user" model="res.groups">
        <field name="name">User</field>
        <field name="privilege_id" ref="res_groups_privilege_farm" />
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]" />
    </record>

    <record id="group_farm_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="privilege_id" ref="res_groups_privilege_farm" />
        <field name="implied_ids" eval="[(4, ref('group_farm_user'))]" />
        <field
            name="user_ids"
            eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"
        />
    </record>

    <record id="farm_season_company_rule" model="ir.rule">
        <field name="name">Farm Season: multi-company</field>
        <field name="model_id" ref="model_farm_season" />
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="global" eval="True" />
    </record>
</odoo>
