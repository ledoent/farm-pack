<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="farm_season_view_list" model="ir.ui.view">
        <field name="name">farm.season.list</field>
        <field name="model">farm.season</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" />
                <field name="code" optional="show" />
                <field name="date_start" />
                <field name="date_end" />
                <field
                    name="state"
                    widget="badge"
                    decoration-info="state == 'planning'"
                    decoration-success="state == 'active'"
                    decoration-muted="state == 'closed'"
                />
                <field
                    name="company_id"
                    groups="base.group_multi_company"
                    optional="show"
                />
            </list>
        </field>
    </record>

    <record id="farm_season_view_form" model="ir.ui.view">
        <field name="name">farm.season.form</field>
        <field name="model">farm.season</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button
                        name="action_activate"
                        type="object"
                        string="Activate"
                        invisible="state != 'planning'"
                        class="oe_highlight"
                    />
                    <button
                        name="action_close"
                        type="object"
                        string="Close"
                        invisible="state != 'active'"
                    />
                    <field
                        name="state"
                        widget="statusbar"
                        statusbar_visible="planning,active,closed"
                    />
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name" />
                        <h1>
                            <field name="name" placeholder="e.g. Spring 2026" />
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="code" placeholder="S26" />
                            <field
                                name="company_id"
                                groups="base.group_multi_company"
                            />
                            <field name="active" invisible="1" />
                        </group>
                        <group>
                            <field name="date_start" />
                            <field name="date_end" />
                        </group>
                    </group>
                    <notebook>
                        <page string="Notes" name="notes">
                            <field name="note" />
                        </page>
                    </notebook>
                </sheet>
                <chatter />
            </form>
        </field>
    </record>

    <record id="farm_season_view_search" model="ir.ui.view">
        <field name="name">farm.season.search</field>
        <field name="model">farm.season</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" />
                <field name="code" />
                <separator />
                <filter
                    string="Planning"
                    name="planning"
                    domain="[('state', '=', 'planning')]"
                />
                <filter
                    string="Active"
                    name="active_state"
                    domain="[('state', '=', 'active')]"
                />
                <filter
                    string="Closed"
                    name="closed"
                    domain="[('state', '=', 'closed')]"
                />
                <filter
                    string="Archived"
                    name="archived"
                    domain="[('active', '=', False)]"
                />
                <group string="Group By">
                    <filter
                        string="State"
                        name="group_state"
                        context="{'group_by': 'state'}"
                    />
                    <filter
                        string="Company"
                        name="group_company"
                        context="{'group_by': 'company_id'}"
                    />
                </group>
            </search>
        </field>
    </record>

    <record id="farm_season_action" model="ir.actions.act_window">
        <field name="name">Seasons</field>
        <field name="res_model">farm.season</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_active_state': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create your first farm season</p>
            <p>Seasons are the time periods plantings, harvests, and herd movements
            roll up into. Most US farms run one or two per year.</p>
        </field>
    </record>
</odoo>
