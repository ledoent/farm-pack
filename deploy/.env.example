# Copy this file to deploy/.env and edit the values.
# .env is gitignored — never commit secrets.

# Database password for the odoo user (random string, used internally)
POSTGRES_PASSWORD=replace-me-with-a-real-password

# Odoo master / admin password (used to create + drop databases)
ADMIN_PASSWORD=replace-me-with-a-real-password

# Database name for the review env. Each branch / partner can get a
# unique DB name so they coexist on one box.
DB_NAME=farm_demo

# Which modules to install on first DB creation. Defaults to the whole
# pack with demo data. Comma-separated, no spaces.
INIT_MODULES=farm_pack,farm_pack_demo

# Load demo data (1) or skip (0)
DEMO=1

# Public port — make sure your reverse proxy / firewall allows this
ODOO_PORT=8069
