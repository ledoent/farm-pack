<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="farm_harvest_view_list" model="ir.ui.view">
        <field name="name">farm.harvest.list</field>
        <field name="model">farm.harvest</field>
        <field name="arch" type="xml">
            <list>
                <field name="harvest_date" />
                <field name="field_id" />
                <field name="crop_id" />
                <field name="qty_harvested" sum="Total" />
                <field name="qty_uom_id" />
                <field name="grade" optional="show" />
                <field name="planting_id" optional="hide" />
                <field name="season_id" optional="hide" />
            </list>
        </field>
    </record>

    <record id="farm_harvest_view_kanban" model="ir.ui.view">
        <field name="name">farm.harvest.kanban</field>
        <field name="model">farm.harvest</field>
        <field name="arch" type="xml">
            <kanban>
                <templates>
                    <t t-name="card">
                        <div class="o_kanban_record_top">
                            <strong>
                                <field name="qty_harvested" />
                                <field name="qty_uom_id" />
                                <field name="crop_id" />
                            </strong>
                        </div>
                        <div>
                            <field name="field_id" />
                        </div>
                        <div class="text-muted">
                            <field name="harvest_date" />
                        </div>
                        <div>
                            <field name="grade" widget="badge" />
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="farm_harvest_view_form" model="ir.ui.view">
        <field name="name">farm.harvest.form</field>
        <field name="model">farm.harvest</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1" />
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="planting_id" />
                            <field name="field_id" readonly="planting_id" />
                            <field name="crop_id" readonly="planting_id" />
                            <field name="harvest_date" />
                        </group>
                        <group>
                            <field name="qty_harvested" />
                            <field name="qty_uom_id" />
                            <field name="grade" />
                            <field name="season_id" />
                            <field
                                name="company_id"
                                groups="base.group_multi_company"
                            />
                        </group>
                    </group>
                    <notebook>
                        <page string="Notes" name="notes">
                            <field name="notes" />
                        </page>
                    </notebook>
                </sheet>
                <chatter />
            </form>
        </field>
    </record>

    <record id="farm_harvest_view_search" model="ir.ui.view">
        <field name="name">farm.harvest.search</field>
        <field name="model">farm.harvest</field>
        <field name="arch" type="xml">
            <search>
                <field name="field_id" />
                <field name="crop_id" />
                <field name="planting_id" />
                <field name="season_id" />
                <separator />
                <filter
                    string="Premium (A)"
                    name="grade_a"
                    domain="[('grade','=','a')]"
                />
                <filter
                    string="This Year"
                    name="this_year"
                    domain="[('harvest_date','&gt;=', (context_today().replace(month=1,day=1)).strftime('%Y-%m-%d'))]"
                />
                <filter
                    string="Last 30 Days"
                    name="last_30"
                    domain="[('harvest_date','&gt;=', (context_today() - relativedelta(days=30)).strftime('%Y-%m-%d'))]"
                />
                <group name="groupby">
                    <filter
                        string="Field"
                        name="groupby_field"
                        context="{'group_by':'field_id'}"
                    />
                    <filter
                        string="Crop"
                        name="groupby_crop"
                        context="{'group_by':'crop_id'}"
                    />
                    <filter
                        string="Grade"
                        name="groupby_grade"
                        context="{'group_by':'grade'}"
                    />
                    <filter
                        string="Season"
                        name="groupby_season"
                        context="{'group_by':'season_id'}"
                    />
                    <filter
                        string="Harvest Date"
                        name="groupby_date"
                        context="{'group_by':'harvest_date'}"
                    />
                </group>
            </search>
        </field>
    </record>

    <record id="farm_harvest_action" model="ir.actions.act_window">
        <field name="name">Harvests</field>
        <field name="res_model">farm.harvest</field>
        <field name="view_mode">kanban,list,form</field>
    </record>
</odoo>
