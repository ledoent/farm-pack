<?xml version="1.0" encoding="utf-8" ?>
<odoo noupdate="1">
    <!-- Seed catalog of common US small-farm crops. noupdate=1 so farmers can edit
         freely without their changes being clobbered on module update. -->

    <record id="crop_tomato" model="farm.crop">
        <field name="name">Tomato</field>
        <field name="latin_name">Solanum lycopersicum</field>
        <field name="category">vegetable</field>
        <field name="family">Solanaceae</field>
        <field name="days_to_maturity">75</field>
    </record>

    <record id="crop_lettuce" model="farm.crop">
        <field name="name">Lettuce</field>
        <field name="latin_name">Lactuca sativa</field>
