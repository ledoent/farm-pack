<?xml version="1.0" encoding="utf-8" ?>
<odoo noupdate="0">
    <!-- Color a couple of catalog entries for kanban demo. -->
    <function model="farm.crop" name="write">
        <value model="farm.crop" search="[('name','=','Tomato')]" />
        <value eval="{'color': 1}" />
    </function>
    <function model="farm.crop" name="write">
        <value model="farm.crop" search="[('name','=','Kale')]" />
        <value eval="{'color': 10}" />
    </function>
</odoo>
