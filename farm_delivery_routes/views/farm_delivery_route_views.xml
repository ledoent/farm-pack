<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="farm_delivery_route_view_list" model="ir.ui.view">
        <field name="name">farm.delivery.route.list</field>
        <field name="model">farm.delivery.route</field>
        <field name="arch" type="xml">
            <list>
                <field name="scheduled_date" />
                <field name="name" />
                <field name="driver_id" />
                <field name="stop_count" />
                <field
                    name="state"
                    widget="badge"
                    decoration-info="state == 'planned'"
                    decoration-warning="state == 'in_progress'"
                    decoration-success="state == 'completed'"
                    decoration-muted="state == 'cancelled'"
                />
            </list>
        </field>
    </record>

    <record id="farm_delivery_route_view_form" model="ir.ui.view">
        <field name="name">farm.delivery.route.form</field>
        <field name="model">farm.delivery.route</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button
                        name="action_start"
                        type="object"
                        string="Start Route"
                        invisible="state != 'planned'"
                        class="oe_highlight"
                    />
                    <button
                        name="action_complete"
                        type="object"
                        string="Finish Route"
                        invisible="state != 'in_progress'"
                        class="oe_highlight"
                    />
                    <button
                        name="action_cancel"
                        type="object"
                        string="Cancel"
                        invisible="state in ('completed', 'cancelled')"
                    />
                    <field
                        name="state"
                        widget="statusbar"
                        statusbar_visible="planned,in_progress,completed"
                    />
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name" />
                        <h1>
                            <field
                                name="name"
                                placeholder="e.g. Tuesday North-Side Drop"
                            />
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="scheduled_date" />
                            <field name="driver_id" />
                        </group>
                        <group>
                            <field name="stop_count" readonly="1" />
                            <field
                                name="company_id"
                                groups="base.group_multi_company"
                            />
                        </group>
                    </group>
                    <notebook>
                        <page string="Stops" name="stops">
                            <field name="stop_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle" />
                                    <field name="dropoff_point_id" />
                                    <field name="address" optional="show" />
                                    <field name="package_count" />
                                    <field name="note" optional="hide" />
                                    <field
                                        name="state"
                                        widget="badge"
                                        decoration-success="state == 'delivered'"
                                        decoration-muted="state == 'skipped'"
                                    />
                                </list>
                            </field>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="note" />
                        </page>
                    </notebook>
                </sheet>
                <chatter />
            </form>
        </field>
    </record>

    <record id="farm_delivery_route_action" model="ir.actions.act_window">
        <field name="name">Routes</field>
        <field name="res_model">farm.delivery.route</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
