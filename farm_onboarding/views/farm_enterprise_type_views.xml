<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="farm_enterprise_type_view_list" model="ir.ui.view">
        <field name="name">farm.enterprise.type.list</field>
        <field name="model">farm.enterprise.type</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle" />
                <field name="icon" />
                <field name="name" />
                <field name="is_animal" />
                <field name="active" optional="hide" />
            </list>
        </field>
    </record>

    <record id="farm_enterprise_type_action" model="ir.actions.act_window">
        <field name="name">Enterprise Types</field>
        <field name="res_model">farm.enterprise.type</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
