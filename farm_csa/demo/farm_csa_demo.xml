<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="product_csa_small_weekly" model="product.product">
        <field name="name">CSA - Small Weekly Share</field>
        <field name="type">service</field>
        <field name="list_price">25.00</field>
        <field name="sale_ok" eval="True" />
    </record>

    <record id="product_csa_family_weekly" model="product.product">
        <field name="name">CSA - Family Weekly Share</field>
        <field name="type">service</field>
        <field name="list_price">42.00</field>
        <field name="sale_ok" eval="True" />
    </record>

    <record id="csa_tier_small" model="farm.csa.tier">
        <field name="name">Small Weekly</field>
        <field name="product_id" ref="product_csa_small_weekly" />
        <field name="cadence">weekly</field>
        <field name="price_per_period">25.00</field>
        <field
            name="description"
        >Eggs (1 dozen), salad greens, herbs of the week.</field>
    </record>

    <record id="csa_tier_family" model="farm.csa.tier">
        <field name="name">Family Weekly</field>
        <field name="product_id" ref="product_csa_family_weekly" />
        <field name="cadence">weekly</field>
        <field name="price_per_period">42.00</field>
        <field
            name="description"
        >Eggs (2 dozen), 4-5 vegetables, herb bunch, weekly fruit.</field>
    </record>

    <record id="csa_partner_alice" model="res.partner">
        <field name="name">Alice Neighbour</field>
        <field name="email">alice@example.com</field>
    </record>

    <record id="csa_partner_bob" model="res.partner">
        <field name="name">Bob Friend</field>
        <field name="email">bob@example.com</field>
    </record>

    <record id="csa_sub_alice" model="farm.csa.subscription">
        <field name="partner_id" ref="csa_partner_alice" />
        <field name="tier_id" ref="csa_tier_small" />
        <field name="date_start" eval="(DateTime.today()).date()" />
        <field name="state">active</field>
        <field name="payment_status">current</field>
        <field name="delivery_method">dropoff</field>
        <field name="delivery_notes">Front porch, gate code 1234.</field>
    </record>

    <record id="csa_sub_bob" model="farm.csa.subscription">
        <field name="partner_id" ref="csa_partner_bob" />
        <field name="tier_id" ref="csa_tier_family" />
        <field name="date_start" eval="(DateTime.today()).date()" />
        <field name="state">active</field>
        <field name="payment_status">paid_ahead</field>
        <field name="delivery_method">pickup_market</field>
    </record>
</odoo>
