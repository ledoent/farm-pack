<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="farm_csa_box_view_list" model="ir.ui.view">
        <field name="name">farm.csa.box.list</field>
        <field name="model">farm.csa.box</field>
        <field name="arch" type="xml">
            <list>
                <field name="delivery_date" />
                <field name="partner_id" />
                <field name="subscription_id" optional="hide" />
                <field name="delivery_method" />
                <field name="line_count" />
                <field
                    name="state"
                    widget="badge"
                    decoration-info="state == 'draft'"
                    decoration-success="state == 'delivered'"
                    decoration-warning="state == 'packed'"
                    decoration-danger="state == 'missed'"
                />
            </list>
        </field>
    </record>

    <record id="farm_csa_box_view_form" model="ir.ui.view">
        <field name="name">farm.csa.box.form</field>
        <field name="model">farm.csa.box</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button
                        name="action_mark_packed"
                        type="object"
                        string="Mark Packed"
                        invisible="state != 'draft'"
                        class="oe_highlight"
                    />
                    <button
                        name="action_mark_delivered"
                        type="object"
                        string="Mark Delivered"
                        invisible="state != 'packed'"
                        class="oe_highlight"
                    />
                    <button
                        name="action_mark_missed"
                        type="object"
                        string="Mark Missed"
                        invisible="state == 'missed'"
                    />
                    <field
                        name="state"
                        widget="statusbar"
                        statusbar_visible="draft,packed,delivered"
                    />
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="subscription_id" />
                            <field name="partner_id" readonly="1" />
                        </group>
                        <group>
                            <field name="delivery_date" />
                            <field name="delivery_method" />
                        </group>
                    </group>
                    <notebook>
                        <page string="Contents" name="contents">
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle" />
                                    <field name="product_id" />
                                    <field name="quantity" />
                                    <field name="uom_id" />
                                    <field name="note" />
                                </list>
                            </field>
                        </page>
                        <page string="Note" name="note">
                            <field name="note" />
                        </page>
                    </notebook>
                </sheet>
                <chatter />
            </form>
        </field>
    </record>

    <record id="farm_csa_box_view_calendar" model="ir.ui.view">
        <field name="name">farm.csa.box.calendar</field>
        <field name="model">farm.csa.box</field>
        <field name="arch" type="xml">
            <calendar
                date_start="delivery_date"
                color="state"
                mode="month"
                event_open_popup="1"
            >
                <field name="partner_id" />
            </calendar>
        </field>
    </record>

    <record id="farm_csa_box_action" model="ir.actions.act_window">
        <field name="name">Weekly Boxes</field>
        <field name="res_model">farm.csa.box</field>
        <field name="view_mode">list,calendar,form</field>
    </record>
</odoo>
